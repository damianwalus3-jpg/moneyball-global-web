# Direct mode: keep this server-side only. Never expose with a VITE_ prefix.
API_FOOTBALL_API_KEY=

# Optional dedicated-egress proxy mode. When both are set, the Worker uses the proxy
# and does not send API_FOOTBALL_API_KEY to API-SPORTS from Cloudflare.
API_FOOTBALL_PROXY_URL=
API_FOOTBALL_PROXY_TOKEN=

# Separate secret for protected ingestion routes.
INGESTION_TOKEN=
