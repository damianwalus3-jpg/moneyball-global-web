{
  "name": "football-intelligence-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "vitest run --config ./vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "db:migrations:list": "wrangler d1 migrations list DB --remote",
    "db:migrations:apply": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run db:migrations:apply && wrangler deploy",
    "build": "node -e \"console.log('No separate asset build is required; Wrangler deploy publishes the Worker.')\""
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.0.8",
    "wrangler": "^4.47.0"
  }
}
